# 自动检测文本文件并规范化换行符
* text=auto

# Shell脚本统一使用LF换行符
*.sh text eol=lf
*.bash text eol=lf

# 配置文件统一使用LF换行符
*.conf text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf

# 文本文件统一使用LF换行符
*.txt text eol=lf
*.md text eol=lf
*.csv text eol=lf

# 二进制文件不做转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.tar.gz binary
*.rar binary
